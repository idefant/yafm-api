generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Commit {
  id        String   @id @default(uuid())
  createdAt DateTime @map("created_at")
  cipher    String   @db.LongText
  iv        String
  hmac      String
  salt      String   @db.Text
  userId    String   @map("user_id")
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@map("commits")
}
